# ====== SOBA – cấu hình môi trường ======
NODE_ENV=production
PORT=3000
# URL công khai của website (không có dấu / ở cuối)
APP_URL=https://soba.vn
# Chuỗi bí mật ngẫu nhiên dài (>= 32 ký tự) để mã hoá session
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# ====== Database ======
# mysql (Hostinger) hoặc sqlite (chạy thử trên máy)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_soba
DB_USER=u123456789_soba
DB_PASSWORD=
# Chỉ dùng khi DB_CLIENT=sqlite
SQLITE_FILE=./data/soba.sqlite

# ====== Lưu file tải lên ======
# Nên đặt NGOÀI thư mục code để không bị xoá khi deploy lại
UPLOAD_DIR=./uploads

# ====== Đăng nhập mạng xã hội (bỏ trống để ẩn nút) ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ====== Thanh toán chuyển khoản VietQR + SePay ======
# Mã ngân hàng theo VietQR (vd: MB, VCB, TCB, ACB...)
BANK_ID=MB
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=NGUYEN VAN A
# API key cấu hình trong SePay > Webhooks (kiểu xác thực "API Key")
SEPAY_WEBHOOK_KEY=

# ====== Email (đặt lại mật khẩu, thông báo) – Hostinger Email ======
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SOBA <hello@soba.vn>"

# ====== Quản trị ======
# Email tài khoản sẽ tự động được cấp quyền admin khi đăng ký
ADMIN_EMAIL=

# ====== Thông tin liên hệ hiển thị trên web ======
CONTACT_PHONE=0900 000 000
CONTACT_ZALO=https://zalo.me/0900000000
CONTACT_EMAIL=hello@soba.vn
CONTACT_FACEBOOK=https://facebook.com/
CONTACT_TIKTOK=https://tiktok.com/
CONTACT_INSTAGRAM=https://instagram.com/
