<section class="section">
  <div class="container container-sm center">
    <div class="script" style="font-size:72px;line-height:1"><%= status %></div>
    <h1 class="h2" style="margin-top:12px"><%= status === 404 ? 'Ôi, trang này lạc mất rồi' : 'Có chút trục trặc' %></h1>
    <p class="lead"><%= message %></p>
    <div class="hero-cta" style="justify-content:center;margin-top:24px">
      <a class="btn btn-primary" href="/">Về trang chủ</a>
      <a class="btn btn-outline" href="/mau-thiep">Xem mẫu thiệp</a>
    </div>
  </div>
</section>
