<div class="page-title"><div><h1>Cài đặt tài khoản</h1><p>Cập nhật thông tin cá nhân và mật khẩu.</p></div></div>
<form class="card form" method="post" action="/tai-khoan/cai-dat" style="max-width:560px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label for="s-email">Email</label><input class="input" id="s-email" value="<%= user.email %>" disabled></div>
  <div class="field"><label for="s-name">Họ và tên</label><input class="input" id="s-name" name="name" value="<%= user.name %>" autocomplete="name"></div>
  <h2 class="h3" style="margin:12px 0 0"><%= user.password_hash ? 'Đổi mật khẩu' : 'Đặt mật khẩu' %></h2>
  <% if (user.password_hash) { %>
  <div class="field"><label for="s-cur">Mật khẩu hiện tại</label><input class="input" id="s-cur" name="current_password" type="password" autocomplete="current-password"></div>
  <% } else { %>
  <p class="small muted" style="margin:0">Bạn đang đăng nhập bằng mạng xã hội. Đặt mật khẩu để có thể đăng nhập bằng email.</p>
  <% } %>
  <div class="field"><label for="s-new">Mật khẩu mới</label><input class="input" id="s-new" name="new_password" type="password" minlength="8" autocomplete="new-password"><span class="hint">Để trống nếu không đổi. Tối thiểu 8 ký tự.</span></div>
  <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
</form>
