<div class="pv-modal" data-pv role="dialog" aria-modal="true" aria-labelledby="pv-name" hidden>
  <div class="pv-box">
    <button class="pv-close btn btn-ghost btn-icon" type="button" data-pv-close aria-label="Đóng xem trước"><svg class="ic"><use href="#i-x"/></svg></button>
    <div class="pv-phone">
      <div class="phone"><div class="phone-screen"><iframe data-pv-frame title="Xem trước mẫu thiệp" src="about:blank"></iframe></div></div>
    </div>
    <div class="pv-info">
      <span class="badge" data-pv-tier></span>
      <h2 id="pv-name" class="h2" data-pv-name></h2>
      <p class="pv-cat" data-pv-cat></p>
      <p class="muted" data-pv-desc></p>
      <ul class="price-list pv-feat" data-pv-feat>
        <li><svg class="ic"><use href="#i-check"/></svg>Hiệu ứng mở thiệp &amp; nhạc nền</li>
        <li><svg class="ic"><use href="#i-check"/></svg>Tên khách mời riêng trên từng link</li>
        <li><svg class="ic"><use href="#i-check"/></svg>Bản đồ chỉ đường, đếm ngược, album ảnh</li>
        <li><svg class="ic"><use href="#i-check"/></svg>Xác nhận tham dự, sổ lời chúc, mừng cưới QR</li>
      </ul>
      <div class="pv-actions">
        <% if (user) { %>
        <form method="post" action="/thiep/tao" data-pv-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="template" value="" data-pv-input>
          <button class="btn btn-primary btn-lg" type="submit"><svg class="ic"><use href="#i-edit"/></svg>Dùng mẫu này</button>
        </form>
        <% } else { %>
        <a class="btn btn-primary btn-lg" href="/dang-ky" data-pv-signup><svg class="ic"><use href="#i-edit"/></svg>Dùng mẫu này</a>
        <% } %>
        <button class="btn btn-outline btn-lg" type="button" data-pv-fav aria-pressed="false"><svg class="ic"><use href="#i-heart"/></svg><span>Lưu mẫu</span></button>
      </div>
      <p class="small" style="margin-top:14px"><a href="#" data-pv-full target="_blank" rel="noopener">Mở toàn màn hình</a> · <a href="#" data-pv-detail>Xem chi tiết mẫu</a></p>
    </div>
  </div>
</div>
<script type="application/json" id="tpl-data"><%- tplJson %></script>
