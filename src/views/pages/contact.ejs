<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span>/</span><span>Liên hệ</span></nav>
    <h1 class="h1" style="font-size:clamp(34px,5vw,56px)">Liên hệ <span class="accent-italic">SOBA</span></h1>
    <p class="lead">Cần hỗ trợ tạo thiệp, thanh toán hay hợp tác? Để lại lời nhắn, chúng tôi phản hồi trong ngày.</p>
  </div>
</section>
<section class="section" style="padding-top:24px">
  <div class="container">
    <div class="grid" style="grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:32px" data-stack-mobile>
      <div class="grid" style="align-content:start;gap:16px">
        <% if (contact.phone) { %>
        <a class="card card-hover" href="tel:<%= contact.phone.replace(/\s/g, '') %>" style="display:flex;gap:16px;align-items:center;text-decoration:none;color:inherit">
          <span class="feature-ic" style="margin:0"><svg class="ic"><use href="#i-phone"/></svg></span>
          <span><strong>Hotline</strong><br><span class="muted"><%= contact.phone %></span></span>
        </a>
        <% } %>
        <% if (contact.zalo) { %>
        <a class="card card-hover" href="<%= contact.zalo %>" target="_blank" rel="noopener" style="display:flex;gap:16px;align-items:center;text-decoration:none;color:inherit">
          <span class="feature-ic" style="margin:0"><svg class="ic"><use href="#i-chat-heart"/></svg></span>
          <span><strong>Zalo</strong><br><span class="muted">Nhắn tin tư vấn nhanh</span></span>
        </a>
        <% } %>
        <% if (contact.email) { %>
        <a class="card card-hover" href="mailto:<%= contact.email %>" style="display:flex;gap:16px;align-items:center;text-decoration:none;color:inherit">
          <span class="feature-ic" style="margin:0"><svg class="ic"><use href="#i-mail"/></svg></span>
          <span><strong>Email</strong><br><span class="muted"><%= contact.email %></span></span>
        </a>
        <% } %>
      </div>
      <form class="card form" method="post" action="/lien-he" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <h2 class="h3" style="margin:0">Gửi lời nhắn</h2>
        <div class="field"><label for="c-name">Họ và tên</label><input class="input" id="c-name" name="name" required autocomplete="name" value="<%= form.name || '' %>"></div>
        <div class="row-2">
          <div class="field"><label for="c-phone">Số điện thoại</label><input class="input" id="c-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" value="<%= form.phone || '' %>"></div>
          <div class="field"><label for="c-email">Email</label><input class="input" id="c-email" name="email" type="email" autocomplete="email" value="<%= form.email || '' %>"></div>
        </div>
        <div class="field"><label for="c-msg">Nội dung</label><textarea class="textarea" id="c-msg" name="message" required rows="5"><%= form.message || '' %></textarea><span class="hint">Nhập ít nhất số điện thoại hoặc email để chúng tôi liên hệ lại.</span></div>
        <button class="btn btn-primary btn-lg" type="submit">Gửi lời nhắn</button>
      </form>
    </div>
  </div>
</section>
