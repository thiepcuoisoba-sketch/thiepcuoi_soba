<div class="page-title"><div><h1>Liên hệ</h1><p>Yêu cầu hỗ trợ gửi từ trang Liên hệ.</p></div></div>
<% if (!contacts.length) { %>
  <div class="card empty"><svg class="ic"><use href="#i-inbox"/></svg><p>Chưa có liên hệ nào.</p></div>
<% } else { %>
<div class="grid grid-2">
  <% contacts.forEach(function (c) { %>
  <div class="card" style="padding:20px">
    <div style="display:flex;justify-content:space-between;gap:10px"><strong><%= c.name %></strong><span class="small muted"><%= formatDateTime(c.created_at) %></span></div>
    <div class="small" style="margin:4px 0 10px">
      <% if (c.phone) { %><a href="tel:<%= c.phone %>"><%= c.phone %></a><% } %>
      <% if (c.phone && c.email) { %> · <% } %>
      <% if (c.email) { %><a href="mailto:<%= c.email %>"><%= c.email %></a><% } %>
    </div>
    <p style="margin:0;color:var(--ink);white-space:pre-line"><%= c.message %></p>
  </div>
  <% }) %>
</div>
<% } %>
