<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= (meta && meta.title) || 'SOBA – Thiệp cưới online' %></title>
<meta name="description" content="<%= (meta && meta.description) || 'SOBA – nền tảng tạo thiệp cưới online đẹp, tinh tế. Tên khách mời riêng, xác nhận tham dự, mừng cưới QR.' %>">
<meta name="theme-color" content="#fffaf7">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="<%= (meta && meta.type) || 'website' %>">
<meta property="og:site_name" content="SOBA">
<meta property="og:title" content="<%= (meta && meta.title) || 'SOBA – Thiệp cưới online' %>">
<meta property="og:description" content="<%= (meta && meta.description) || 'Tạo thiệp cưới online đẹp, tinh tế trong 10 phút.' %>">
<meta property="og:url" content="<%= appUrl %><%= path %>">
<link rel="canonical" href="<%= appUrl %><%= path %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="<%= ALL_FONTS_URL %>">
<link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
